{
  "version": "1.0",
  "title": "The Water Cycle",
  "canvas": {
    "aspect_ratio": "16:9",
    "background_color": "white"
  },
  "transcript": "The water cycle moves water endlessly around our planet. It begins with evaporation, as the sun heats oceans and lakes, turning liquid water into vapor. This vapor rises and cools, forming clouds through condensation. Finally, precipitation returns water to Earth as rain or snow. And the cycle begins again.",
  "default_animation": {
    "type": "fade_in",
    "easing": "ease_out"
  },
  "actions": [
    {
      "action_id": "create_water_body",
      "action_type": "create",
      "trigger_phrase": "as the sun heats oceans and lakes",
      "element": {
        "id": "water_body",
        "element_type": "shape",
        "shape": "rectangle",
        "width_percent": 35,
        "height_percent": 12,
        "fill_color": "blue",
        "border_color": "black",
        "border_width": 2,
        "position": {
          "type": "canvas",
          "x_percent": 25,
          "y_percent": 80,
          "anchor": "center"
        }
      },
      "animation": {
        "type": "draw_in",
        "direction": "left_to_right"
      }
    },
    {
      "action_id": "create_water_label",
      "action_type": "create",
      "trigger_phrase": "as the sun heats oceans and lakes",
      "element": {
        "id": "water_label",
        "element_type": "text",
        "content": "Ocean / Lake",
        "font_size": "medium",
        "color": "white",
        "bold": true,
        "position": {
          "type": "relative",
          "relative_to": "water_body",
          "placement": "center_of",
          "gap_percent": 0
        }
      }
    },
