{
  "version": "1.0",
  "title": "Supply and Demand",
  "canvas": {
    "aspect_ratio": "16:9",
    "background_color": "white"
  },
  "transcript": "The demand curve slopes downward because people buy less when prices are high. The supply curve slopes upward because producers offer more at higher prices. Where the two curves cross is the equilibrium point. This determines both the equilibrium price and the equilibrium quantity in the market.",
  "default_animation": {
    "type": "fade_in",
    "easing": "ease_out"
  },
  "actions": [
    {
      "action_id": "create_demand_curve",
      "action_type": "create",
      "trigger_phrase": "The demand curve slopes downward",
      "element": {
        "id": "demand_curve",
        "element_type": "shape",
        "shape": "arrow",
        "width_percent": 40,
        "height_percent": 2,
        "fill_color": "blue",
        "border_color": "blue",
        "rotation_degrees": 45,
        "position": {
          "type": "canvas",
          "x_percent": 30,
          "y_percent": 30,
          "anchor": "top_left"
        }
      },
      "animation": {
        "type": "draw_in",
        "direction": "left_to_right"
      }
    },
    {
      "action_id": "create_demand_label",
      "action_type": "create",
      "trigger_phrase": "people buy less when prices are high",
      "element": {
        "id": "demand_label",
        "element_type": "text",
        "content": "Demand",
        "font_size": "medium",
        "color": "blue",
        "bold": true,
        "position": {
          "type": "canvas",
          "x_percent": 18,
          "y_percent": 25,
          "anchor": "center"
        }
      },
      "animation": {
        "type": "typewriter"
      }
    },
    {
      "action_id": "create_supply_curve",
      "action_type": "create",
      "trigger_phrase": "The supply curve slopes upward",
      "element": {
        "id": "supply_curve",
        "element_type": "shape",
        "shape": "arrow",
        "width_percent": 40,
        "height_percent": 2,
        "fill_color": "red",
        "border_color": "red",
        "rotation_degrees": -45,
        "position": {
          "type": "canvas",
          "x_percent": 30,
          "y_percent": 70,
          "anchor": "bottom_left"
        }
      },
      "animation": {
        "type": "draw_in",
        "direction": "left_to_right"
      }
    },
    {
      "action_id": "create_supply_label",
      "action_type": "create",
      "trigger_phrase": "producers offer more at higher prices",
      "element": {
        "id": "supply_label",
        "element_type": "text",
        "content": "Supply",
        "font_size": "medium",
        "color": "red",
        "bold": true,
        "position": {
          "type": "canvas",
          "x_percent": 18,
          "y_percent": 75,
          "anchor": "center"
        }
      },
      "animation": {
        "type": "typewriter"
      }
    },
    {
      "action_id": "create_equilibrium_point",
      "action_type": "create",
      "trigger_phrase": "the equilibrium point",
      "element": {
        "id": "equilibrium_point",
        "element_type": "shape",
        "shape": "circle",
        "width_percent": 4,
        "height_percent": 7,
        "fill_color": "yellow",
        "border_color": "black",
        "border_width": 3,
        "position": {
          "type": "canvas",
          "x_percent": 50,
          "y_percent": 50,
          "anchor": "center"
        }
      },
      "animation": {
        "type": "pop_in"
      }
    },
    {
      "action_id": "create_price_label",
      "action_type": "create",
      "trigger_phrase": "the equilibrium price",
      "element": {
        "id": "price_label",
        "element_type": "text",
        "content": "Equilibrium\nPrice",
        "font_size": "medium",
        "color": "green",
        "bold": true,
        "text_align": "right",
        "position": {
          "type": "canvas",
          "x_percent": 12,
          "y_percent": 50,
          "anchor": "right"
        }
      },
      "animation": {
        "type": "typewriter"
      }
    },
    {
      "action_id": "create_quantity_label",
      "action_type": "create",
      "trigger_phrase": "equilibrium quantity",
      "element": {
        "id": "quantity_label",
        "element_type": "text",
        "content": "Equilibrium Quantity",
        "font_size": "medium",
        "color": "green",
        "bold": true,
        "text_align": "center",
        "position": {
          "type": "canvas",
          "x_percent": 50,
          "y_percent": 90,
          "anchor": "center"
        }
      },
      "animation": {
        "type": "typewriter"
      }
    }
  ]
}