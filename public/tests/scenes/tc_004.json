{
  "version": "1.0",
  "title": "Simple vs Compound Interest",
  "canvas": {
    "aspect_ratio": "16:9",
    "background_color": "white"
  },
  "transcript": "Simple interest grows by the same amount each year. Compound interest earns interest on your interest. Let's watch them grow over ten years. Simple interest adds steadily. But compound interest accelerates far ahead.",
  "default_animation": {
    "type": "fade_in",
    "easing": "ease_out"
  },
  "actions": [
    {
      "action_id": "create_simple_bar",
      "action_type": "create",
      "trigger_phrase": "Simple interest grows",
      "element": {
        "id": "simple_bar",
        "element_type": "shape",
        "shape": "rectangle",
        "width_percent": 18,
        "height_percent": 12,
        "fill_color": "blue",
        "border_color": "black",
        "border_width": 2,
        "position": {
          "type": "canvas",
          "x_percent": 30,
          "y_percent": 70,
          "anchor": "bottom"
        }
      },
      "animation": {
        "type": "draw_in",
        "direction": "bottom_to_top"
      }
    },
    {
      "action_id": "create_simple_label",
      "action_type": "create",
      "trigger_phrase": "Simple interest grows",
      "element": {
        "id": "simple_label",
        "element_type": "text",
        "content": "Simple",
        "font_size": "medium",
        "color": "black",
        "bold": true,
        "position": {
          "type": "relative",
          "relative_to": "simple_bar",
          "placement": "below",
          "gap_percent": 2,
          "align": "center"
        }
      }
    },
    {
      "action_id": "create_compound_bar",
      "action_type": "create",
      "trigger_phrase": "Compound interest earns",
      "element": {
        "id": "compound_bar",
        "element_type": "shape",
        "shape": "rectangle",
        "width_percent": 18,
        "height_percent": 12,
        "fill_color": "blue",
        "border_color": "black",
        "border_width": 2,
        "position": {
          "type": "canvas",
          "x_percent": 70,
          "y_percent": 70,
          "anchor": "bottom"
        }
      },
      "animation": {
        "type": "draw_in",
        "direction": "bottom_to_top"
      }
    },
    {
      "action_id": "create_compound_label",
      "action_type": "create",
      "trigger_phrase": "Compound interest earns",
      "element": {
        "id": "compound_label",
        "element_type": "text",
        "content": "Compound",
        "font_size": "medium",
        "color": "black",
        "bold": true,
        "position": {
          "type": "relative",
          "relative_to": "compound_bar",
          "placement": "below",
          "gap_percent": 2,
          "align": "center"
        }
      }
    },
    {
      "action_id": "create_timeline",
      "action_type": "create",
      "trigger_phrase": "over ten years",
      "element": {
        "id": "timeline",
        "element_type": "shape",
        "shape": "arrow",
        "width_percent": 1,
        "height_percent": 2,
        "fill_color": "black",
        "border_color": "black",
        "position": {
          "type": "canvas",
          "x_percent": 50,
          "y_percent": 15,
          "anchor": "center"
        }
      },
      "animation": {
        "type": "draw_in",
        "direction": "left_to_right"
      }
    },
    {
      "action_id": "create_time_label",
      "action_type": "create",
      "trigger_phrase": "over ten years",
      "element": {
        "id": "time_label",
        "element_type": "text",
        "content": "10 Years",
        "font_size": "large",
        "color": "black",
        "bold": true,
        "position": {
          "type": "relative",
          "relative_to": "timeline",
          "placement": "above",
          "gap_percent": 2,
          "align": "center"
        }
      }
    },
    {
      "action_id": "grow_simple_steady",
      "action_type": "edit",
      "trigger_phrase": "Simple interest adds steadily",
      "element_id": "simple_bar",
      "changes": {
        "height_percent": 35
      },
      "animation": {
        "type": "pop_highlight"
      }
    },
    {
      "action_id": "grow_compound_fast",
      "action_type": "edit",
      "trigger_phrase": "compound interest accelerates",
      "element_id": "compound_bar",
      "changes": {
        "height_percent": 55,
        "fill_color": "green"
      },
      "animation": {
        "type": "pop_highlight"
      }
    }
  ]
}