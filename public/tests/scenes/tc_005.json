{
  "version": "1.0",
  "title": "How a Bill Becomes a Law",
  "canvas": {
    "aspect_ratio": "16:9",
    "background_color": "white"
  },
  "transcript": "A bill starts when a member of Congress introduces it. The bill then goes to a committee for review. If approved, it moves to the full chamber for a floor vote. Once both chambers pass it, the bill goes to the President for signature. When the President signs, the bill becomes law.",
  "default_animation": {
    "type": "fade_in",
    "easing": "ease_out"
  },
  "actions": [
    {
      "action_id": "create_bill_box",
      "action_type": "create",
      "trigger_phrase": "a member of Congress introduces it",
      "element": {
        "id": "bill_box",
        "element_type": "shape",
        "shape": "rectangle",
        "width_percent": 14,
        "height_percent": 12,
        "fill_color": "blue",
        "border_color": "black",
        "border_width": 2,
        "text": "Bill Introduced",
        "text_color": "white",
        "font_size": "small",
        "position": {
          "type": "canvas",
          "x_percent": 10,
          "y_percent": 50,
          "anchor": "center"
        }
      },
      "animation": {
        "type": "pop_in"
      }
    },
    {
      "action_id": "create_arrow_1",
      "action_type": "create",
      "trigger_phrase": "goes to a committee for review",
      "element": {
        "id": "arrow_1",
        "element_type": "shape",
        "shape": "arrow",
        "width_percent": 1,
        "height_percent": 1.5,
        "fill_color": "black",
        "border_color": "black",
        "position": {
          "type": "connected",
          "from_element": "bill_box",
          "from_anchor": "right",
          "to_element": "committee_box",
          "to_anchor": "left"
        }
